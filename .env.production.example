# Copy to .env.production and fill in the empty secret values before starting.
# Generate independent URL-safe secrets with: openssl rand -hex 32
NODE_ENV=production
PORT=8080
BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=
DATABASE_URL=postgres://tariffia:REPLACE_WITH_URL_SAFE_DATABASE_PASSWORD@localhost:5432/tariffia
TRUST_PROXY=false
API_RATE_LIMIT_PER_MINUTE=300
ADMIN_API_KEY=
API_KEY_PEPPER=
PUBLIC_BASE_URL=https://pay.example.com
BASE_RPC_URL=https://mainnet.base.org
USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32d4F71b54bdA02913
USDC_MIN_CONFIRMATIONS=12
PAYMENT_DETECTOR_INTERVAL_MS=10000
PAYMENT_SCAN_LOOKBACK_BLOCKS=100
PAYMENT_SCAN_BLOCK_RANGE=500
PAYMENT_EXPIRATION_MINUTES=60
SUBSCRIPTION_BILLING_INTERVAL_MS=60000
# AI provider credentials are read from the environment only and are never stored in the database.
OPENAI_API_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=512
AI_AUTHORIZATION_BUFFER_BPS=1000
AI_MAX_PROMPT_TOKENS=32000
# SMS provider credentials are read from the environment only and are never stored in the database.
SMS_PROVIDER_ENABLED=true
SMS_HTTP_BASE_URL=
SMS_HTTP_API_KEY=
SMS_HTTP_TIMEOUT_MS=30000
SMS_HTTP_SEND_PATH=/v1/messages
SMS_HTTP_HEALTH_PATH=/health
# TextBee credentials are read from the environment only and are never stored in the database.
TEXTBEE_ENABLED=false
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_API_KEY=
TEXTBEE_TIMEOUT_MS=30000
TEXTBEE_DEVICE_ID=
TEXTBEE_SIM_SUBSCRIPTION_ID=0
# Per-merchant request limits per minute; 0 means unlimited for a merchant override.
MERCHANT_GENERAL_REQUESTS_PER_MINUTE=300
MERCHANT_AI_REQUESTS_PER_MINUTE=60
MERCHANT_SMS_REQUESTS_PER_MINUTE=60
USDC_ADAPTER_ENABLED=true
LIGHTNING_ADAPTER_ENABLED=false
LIGHTNING_NETWORK=mainnet
LIGHTNING_MINIMUM_AMOUNT_SATS=1
LIGHTNING_MAXIMUM_AMOUNT_SATS=100000000
LIGHTNING_INVOICE_EXPIRY_SECONDS=3600
LIGHTNING_PROVIDER_TYPE=none
LIGHTNING_PROVIDER_URL=
LIGHTNING_PROVIDER_MACAROON=
LIGHTNING_PROVIDER_IDEMPOTENCY_SECRET=
LIGHTNING_PROVIDER_TIMEOUT_MS=5000
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_WORKER_INTERVAL_MS=3000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_REQUEST_TIMEOUT_MS=10000
CREDITS_PER_USDC_RATE=100
CREDIT_MINIMUM_TOPUP_USDC=1.000000
CREDIT_MAXIMUM_TOPUP_USDC=1000.000000
