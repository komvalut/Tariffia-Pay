{
  "name": "@tariffia/pay",
  "version": "0.1.0",
  "description": "Official server-side TypeScript client and browser-safe checkout helpers for Tariffia Pay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/komvalut/Tariffia-Pay.git",
    "directory": "sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
